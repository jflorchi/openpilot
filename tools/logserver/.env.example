# Public URL of the tunnel. Must match the hostname you configure in the
# Cloudflare Zero Trust dashboard for this tunnel.
BASE_URL=https://openpilot.example.com

# From Zero Trust > Networks > Tunnels > Create a tunnel (connector token).
TUNNEL_TOKEN=

# Optional shared secret required to register a device.
# Generate with: openssl rand -hex 16
REGISTRATION_TOKEN=

# Password for the web interface at /ui. Leave empty to keep the UI disabled.
#
# Careful: docker compose expands '$' in .env values, so a password containing
# one arrives mangled, and quotes are kept literally. If your password has any
# punctuation, write it to ./data/web_password instead -- that is read verbatim
# and takes over when WEB_PASSWORD is empty:
#   printf '%s' 'your password' > data/web_password
WEB_PASSWORD=

# Set to 1 only if every client reaches the UI over https. It marks the session
# cookie Secure, which makes browsers refuse it on plain-http LAN access.
SECURE_COOKIE=
